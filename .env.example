# Copy to .env (docker compose reads it automatically) or export for local dev
CARSCOUT_DATABASE_URL=postgresql://carscout:carscout@postgres:5432/carscout
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
FIXTURE_BASE_URL=http://fixture:8088
FIXTURE_SECRET=carscout-demo-secret-v1

# crawl tuning
FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=180
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
FINGERPRINT_TTL_SECONDS=3888000
SCHEDULER_TICK_SECONDS=20
PLATFORM_STALL_TIMEOUT_SECONDS=300
MAX_PARALLEL_PLATFORMS=4

# match thresholds (see README §跨平台归并)
# 注：线上阈值以 merge_rule_versions 中 active 规则版本为准；下列变量仅作进程级兜底
AUTO_MERGE_SCORE=0.82
GRAY_ZONE_SCORE=0.60
RECALL_REG_MONTHS=9
RECALL_MILEAGE_KM=9000

# 规则版本离线回放的人工审批门槛：超出任一值，激活前必须人工审批
REPLAY_MAX_EXTRA_MERGES=10
REPLAY_MAX_SPLIT_CONFIRMED=0

# browser
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
API_PORT=8000
